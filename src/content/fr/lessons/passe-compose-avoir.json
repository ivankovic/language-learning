      "type": "multiple-choice",
      "prompt": "What is the past participle of \"boire\" (to drink)?",
      "answer": "bu",
      "distractors": ["boiré", "buvé", "boivé"],
      "relatedItemId": "fr-vocab-routine-005"
    },
    {
