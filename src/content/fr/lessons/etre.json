      "type": "fill-blank",
      "prompt": "Je ___ française. (I am French — feminine speaker)",
      "answer": "suis"
    },
    {
      "id": "fr-ex-etre-2",
      "type": "multiple-choice",
      "prompt": "Tu ___ fatigué. (You are tired.)",
      "answer": "es",
