  "prerequisiteIds": ["fr-lesson-articles"],
  "blocks": [
    { "type": "explanation", "markdown": "**Être** (to be) is irregular and one of the most-used verbs in French:\n\nje **suis** · tu **es** · il/elle **est** · nous **sommes** · vous **êtes** · ils/elles **sont**" },
    { "type": "exercise", "exerciseId": "fr-ex-etre-1" },
    { "type": "exercise", "exerciseId": "fr-ex-etre-2" },
    { "type": "explanation", "markdown": "**Enchanté** literally means \"delighted\" and is what you say when meeting someone for the first time." },
    { "type": "exercise", "exerciseId": "fr-ex-etre-3" },
    { "type": "exercise", "exerciseId": "fr-ex-etre-4" }
  ],
  "exercises": [
