      "id": "fr-ex-avoir-1",
      "type": "fill-blank",
      "prompt": "J'___ faim. (I'm hungry.)",
      "answer": "ai",
      "relatedItemId": "fr-vocab-routine-026"
    },
    {
      "id": "fr-ex-avoir-2",
      "type": "multiple-choice",
      "prompt": "How do you say \"I am 20 years old\" (literally \"I have 20 years\")?",
